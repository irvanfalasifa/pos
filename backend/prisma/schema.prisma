generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  roles        UserRole[]
  orders       Order[]
  payments     Payment[]
  statusLogs   OrderStatusLog[]
  auditLogs    AuditLog[]
  refundsCreated  Refund[] @relation("RefundCreatedBy")
  refundsApproved Refund[] @relation("RefundApprovedBy")
  tokenVersion       Int     @default(0)
  mustChangePassword Boolean @default(false)
  deletedAt DateTime?
  shifts Shift[] @relation("ShiftCashier")
  shiftsReviewed Shift[] @relation("ShiftReviewedBy")
  cashMovements CashMovement[] @relation("CashMovementCreatedBy")
  stockMovements StockMovement[] @relation("StockMovementCreatedBy")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  label       String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    Int              @id @default(autoincrement())
  code  String           @unique
  label String
  roles RolePermission[]
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  sku         String?          @unique
  description String?
  price       Int
  isActive    Boolean          @default(true)
  categoryId  Int
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  modifierGroups ProductModifierGroup[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  orderItems  OrderItem[]
  recipes     Recipe[]
}

model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int
  name       String
  priceDelta Int     @default(0)
  isActive   Boolean @default(true)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  recipes    Recipe[]
}

model ModifierGroup {
  id        Int                    @id @default(autoincrement())
  name      String                 @unique
  minSelect Int                    @default(0)
  maxSelect Int                    @default(1)
  isActive  Boolean                @default(true)
  options   Modifier[]
  products  ProductModifierGroup[]
}

model Modifier {
  id       Int           @id @default(autoincrement())
  groupId  Int
  name     String
  price    Int           @default(0)
  isActive Boolean       @default(true)
  group    ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemModifiers  OrderItemModifier[]
  ingredients ModifierIngredient[]
}

model ProductModifierGroup {
  productId Int
  groupId   Int
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  QR_TABLE
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Setting {
  key   String @id
  value String
}

model Area {
  id     Int               @id @default(autoincrement())
  name   String            @unique
  tables RestaurantTable[]
}

model RestaurantTable {
  id            Int         @id @default(autoincrement())
  name          String
  capacity      Int         @default(4)
  status        TableStatus @default(AVAILABLE)
  isActive      Boolean     @default(true)
  occupiedSince DateTime?
  areaId        Int
  area          Area        @relation(fields: [areaId], references: [id])
  orders        Order[]

  @@unique([areaId, name])
}

model Order {
  id            Int              @id @default(autoincrement())
  number        String           @unique
  type          OrderType
  status        OrderStatus      @default(PLACED)
  paymentStatus PaymentStatus    @default(UNPAID)
  tableId       Int?
  table         RestaurantTable? @relation(fields: [tableId], references: [id])
  customerName  String?
  note          String?
  subtotal      Int
  serviceBp     Int
  serviceAmount Int
  taxBp         Int
  taxAmount     Int
  roundingAmount Int @default(0)
  total         Int
  createdById   Int
  createdBy     User             @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  items         OrderItem[]
  payments      Payment[]
  statusLogs    OrderStatusLog[]
  refunds       Refund[]
  cancelReason  String?
  cancelledAt   DateTime?
  shiftId       Int?
  shift Shift? @relation(fields: [shiftId], references: [id])
  stockDeductedAt DateTime?

  @@index([createdAt])
}

model OrderItem {
  id          Int                 @id @default(autoincrement())
  orderId     Int
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product             @relation(fields: [productId], references: [id])
  variantId   Int?
  variant     ProductVariant?     @relation(fields: [variantId], references: [id])
  productName String
  variantName String?
  unitPrice   Int
  quantity    Int
  note        String?
  lineTotal   Int
  modifiers   OrderItemModifier[]
}

model OrderItemModifier {
  id          Int       @id @default(autoincrement())
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierId  Int
  modifier    Modifier  @relation(fields: [modifierId], references: [id])
  name        String
  price       Int
}

enum PaymentMethod {
  CASH
  QRIS
  CARD
  EWALLET
  TRANSFER
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  order          Order         @relation(fields: [orderId], references: [id])
  method         PaymentMethod
  amount         Int
  tendered       Int?
  changeAmount   Int?
  reference      String?
  idempotencyKey String        @unique
  createdById    Int
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  refunds        Refund[]
  shiftId        Int?
  shift Shift? @relation(fields: [shiftId], references: [id])

  @@index([orderId])
}

model OrderStatusLog {
  id         Int         @id @default(autoincrement())
  orderId    Int
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus
  toStatus   OrderStatus
  userId     Int
  user       User        @relation(fields: [userId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([orderId])
}

model Refund {
  id           Int      @id @default(autoincrement())
  paymentId    Int
  payment      Payment  @relation(fields: [paymentId], references: [id])
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id])
  amount       Int
  reason       String
  approvedById Int
  approvedBy   User     @relation("RefundApprovedBy", fields: [approvedById], references: [id])
  createdById  Int
  createdBy    User     @relation("RefundCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  shiftId      Int?
  shift Shift? @relation(fields: [shiftId], references: [id])

  @@index([orderId])
  @@index([paymentId])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  action       String
  entityType   String
  entityId     Int
  beforeData   Json?
  afterData    Json?
  reason       String?
  approvedById Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model LoginEvent {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([userId])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  IN
  OUT
}

model Shift {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation("ShiftCashier", fields: [userId], references: [id])
  openedAt       DateTime      @default(now())
  closedAt       DateTime?
  openingCash    Int
  expectedCash   Int?
  closingCash    Int?
  cashDifference Int?
  closingNote    String?
  status         ShiftStatus   @default(OPEN)
  reviewedById   Int?
  reviewedBy     User?         @relation("ShiftReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  orders         Order[]
  payments       Payment[]
  refunds        Refund[]
  movements      CashMovement[]

  @@index([userId, status])
  @@index([openedAt])
}

model CashMovement {
  id           Int              @id @default(autoincrement())
  shiftId      Int
  shift        Shift            @relation(fields: [shiftId], references: [id])
  type         CashMovementType
  amount       Int
  reason       String
  approvedById Int?
  createdById  Int
  createdBy    User             @relation("CashMovementCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([shiftId])
}

enum StockMovementType {
  OPENING
  PURCHASE_IN
  MANUAL_IN
  MANUAL_OUT
  ADJUSTMENT
  WASTE
  SALE_USAGE
  SALE_RETURN
}

model Ingredient {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  sku            String?   @unique
  unit           String
  purchaseUnit   String?
  purchaseFactor Int?
  currentStock   Int       @default(0)
  minimumStock   Int       @default(0)
  averageCost    Float     @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  recipeItems    RecipeItem[]
  modifierUsages ModifierIngredient[]
  movements      StockMovement[]
}

model Recipe {
  id            Int          @id @default(autoincrement())
  productId     Int
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     Int?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  yieldQuantity Int          @default(1)
  isActive      Boolean      @default(true)
  items         RecipeItem[]

  @@index([productId])
}

model RecipeItem {
  id           Int        @id @default(autoincrement())
  recipeId     Int
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Int
}

model ModifierIngredient {
  id           Int        @id @default(autoincrement())
  modifierId   Int
  modifier     Modifier   @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Int

  @@unique([modifierId, ingredientId])
}

model StockMovement {
  id            Int               @id @default(autoincrement())
  ingredientId  Int
  ingredient    Ingredient        @relation(fields: [ingredientId], references: [id])
  type          StockMovementType
  quantityIn    Int               @default(0)
  quantityOut   Int               @default(0)
  unitCost      Float?
  balanceAfter  Int
  referenceType String?
  referenceId   Int?
  reason        String?
  createdById   Int
  createdBy     User              @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([ingredientId, createdAt])
  @@index([referenceType, referenceId])
}